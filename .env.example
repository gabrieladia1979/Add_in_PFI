# ==============================================================================
# Variables de entorno para PhishARG Hybrid Piloto (Configurar en Vercel)
# ==============================================================================
# Origen HTTPS del servicio backend en AWS ECS Fargate (sin rutas ni credenciales)
API_BASE_URL=https://api.phisharg.com

# Clave secreta compartida para la firma criptográfica HMAC de tokens de análisis
PHISHARG_TOKEN_KEY=tu_clave_secreta_compartida_con_ecs

# Identificador de la regla de control de tasa de solicitudes (Vercel Firewall)
PHISHARG_RATE_LIMIT_ID=hybrid_rate_limit_rule
